[Unit]
Description=xblog Next.js frontend
After=network.target xblog-api.service

[Service]
Type=simple
User=appuser
Group=appuser
WorkingDirectory=/home/appuser/xblog/apps/web
Environment=NODE_ENV=production
EnvironmentFile=-/home/appuser/xblog/apps/web/.env
ExecStart=/usr/local/bin/pnpm start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
