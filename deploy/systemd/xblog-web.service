[Unit]
Description=xblog Next.js frontend
After=network.target xblog-api.service

[Service]
Type=simple
User=appuser
Group=appuser
WorkingDirectory=/home/appuser/xblog/frontend
Environment=NODE_ENV=production
EnvironmentFile=-/home/appuser/xblog/frontend/.env
ExecStart=/home/appuser/xblog/frontend/node_modules/.bin/next start -H 127.0.0.1 -p 3000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
