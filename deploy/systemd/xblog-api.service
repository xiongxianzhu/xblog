[Unit]
Description=xblog FastAPI API
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=appuser
Group=appuser
WorkingDirectory=/home/appuser/xblog/backend
EnvironmentFile=/home/appuser/xblog/backend/.env
ExecStart=/home/appuser/.local/bin/uv run --no-sync uvicorn app.main:app --host 127.0.0.1 --port 10242 --workers 4
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
